#!/usr/bin/env python3
"""Auto brightness from the laptop's own ambient light sensors (iio "als").

No camera, no habit learning. v2 works like a MacBook:
  - log-lux curve with gamma and an 8 % floor
  - your own change becomes a +/- offset on the curve (no pause timer); the
    offset is dropped when the room light moves >2.5x from where you set it,
    after resume / lid open, or on the next day
  - brightens fast (~1.5 s), dims in ~4 s fades; a big drop (sensor covered, lights
    off) dims part-way after ~5 s and fully after ~10 s (2.5.0)
  - ignores light changes under 12 % and spikes/shadows shorter than 2 s;
    the brighter of the two sensors wins
  - never dims while a fullscreen video plays
  - keyboard light: native levels only (off/1/2), on below 4 lx only after
    15 s of darkness, off above 12 lx at once; the Dell firmware's own inactivity timeout turns it off and the next
    key press turns it back on (we never fight that)

  omarchy-auto-brightness run          the daemon (systemd user service)
  omarchy-auto-brightness status       JSON state (for the bar widget)
  omarchy-auto-brightness on|off       enable / disable
  omarchy-auto-brightness set KEY VAL  min|max|keyboard
  omarchy-auto-brightness lux          print current lux once
  omarchy-auto-brightness sensors      what the light sensors expose (colour?)
"""
import datetime, glob, json, math, os, subprocess, sys, time

HOME = os.environ.get("HOME", "")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "omarchy", "auto-brightness.json")
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
STATE = os.path.join(RUN, "omarchy-auto-brightness.json")
HOLD_FLAG = os.path.join(RUN, "omarchy-walk-away.dimmed")  # walk-away lock owns the screen

DEFAULTS = {
    "enabled": True,
    "min": 8,              # screen %, darkest room (your slider is the real floor)
    "max": 100,            # screen %, sunlight
    "gamma": 0.8,          # <1 lifts the dim end of the curve
    "fullLux": 10000,      # lux that maps to max
    "keyboard": True,
    "kbdOnBelow": 4,       # lux: keyboard level 1 below this (XPS 14 sensors: lit room ~16-35 lx)
    "kbdLevel2Below": 1,   # lux: level 2 below this (very dark; 0 = never)
    "kbdLevel2Exit": 2,    # lux: and back to level 1 only above this (hysteresis)
    "kbdOffAbove": 12,     # lux: off above this
    "kbdOnSeconds": 3.0,   # darker keyboard level only after the darkness held this long; big drops
                           # already wait dimHoldSeconds, so a 250 -> 0 lx tunnel lights it after ~15 s
    "dimHoldSeconds": 8.0,   # a drop to under half the light must hold this long before the screen dims fully
    "dimQuickSeconds": 2.5,  # 2.5.0: ...but after this long it already dims part-way (half the drop, in
                             # log-lux), so covering the sensor shows a reaction in ~5 s; short train dips
                             # (2-7 s) dim only part-way and come back in 1.5 s (Android: darkening 8 s)
    "dimBigRatio": 0.5,
    "brightenSeconds": 1.5,
    "dimSeconds": 4.0,       # 2.5.0: was 7 s (macOS ramps ~5 s)
    "luxDeadband": 0.12,   # ignore lux changes smaller than 12 %
    "luxAbsDeadband": 2.0, # ...and smaller than 2 lx (dark end: sensor wobbles 0 <-> 1 lx)
    "darkLux": 2.0,        # the curve treats 0..2 lx as fully dark (no 12-point step at 1 lx)
    "settleSeconds": 2.0,  # a change must last this long (spikes, shadows)
    "offsetResetRatio": 2.5,
    "sensorMedianSeconds": 4.0,  # per-sensor median: drops the XPS HID sensors' bogus 1-2 s bursts (0 -> 40000 lx)
    "jumpSeconds": 10.0,   # an implausible jump (dark -> sunlight) must hold this long, every sample high
    "jumpDarkLux": 50.0,   # "dark" stable value for the jump rule
    "jumpFactor": 5.0,     # implausible: from < jumpDarkLux to > jumpFactor*stable + jumpAbsLux
    "jumpAbsLux": 500.0,
    "jumpHugeLux": 20000.0,  # ...or above this from a dark stable value
}
MAX_LUX = 60000


def load_conf():
    c = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            c.update(json.load(f))
    except (OSError, ValueError):
        pass
    c["min"] = max(1, min(100, int(c["min"])))
    c["max"] = max(c["min"], min(100, int(c["max"])))
    return c


def save_conf(c):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    keep = {k: c[k] for k in ("enabled", "min", "max", "keyboard") if k in c}
    try:
        with open(CONF) as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = {}
    old.update(keep)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        json.dump(old, f, indent=2)
        f.write("\n")
    os.replace(tmp, CONF)


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def sensors():
    out = []
    for d in sorted(glob.glob("/sys/bus/iio/devices/iio:device*")):
        if read(d + "/name") != "als":
            continue
        if os.path.exists(d + "/in_illuminance_input"):
            out.append((d + "/in_illuminance_input", 1.0))
        elif os.path.exists(d + "/in_illuminance_raw"):
            out.append((d + "/in_illuminance_raw", float(read(d + "/in_illuminance_scale", "1") or 1)))
    return out


def lux_once(sens):
    """One raw sample per sensor (None = unreadable or impossible)."""
    out = []
    for path, scale in sens:
        try:
            lux = float(read(path)) * scale
        except (TypeError, ValueError):
            lux = None
        out.append(lux if lux is not None and 0 <= lux <= MAX_LUX else None)
    return out


def lux_now(sens):
    vals = [v for v in lux_once(sens) if v is not None]
    return max(vals) if vals else None  # the brighter sensor wins


class SensorFilter:
    """Per-sensor rolling median over `secs`, then the brighter sensor wins.
    The XPS 14 HID light sensors sometimes report a burst of 0.5-1.5 s of
    garbage (tens of thousands of lux in a dark room), alternating between the
    two sensors, so max() of raw samples saw a >2 s 'sunlight' spike. A median
    per sensor needs a change to hold for over half the window."""

    def __init__(self, n, secs):
        self.secs, self.hist = secs, [[] for _ in range(n)]

    def feed(self, t, samples):
        best = None
        for h, v in zip(self.hist, samples):
            if v is not None:
                h.append((t, v))
            while h and t - h[0][0] > self.secs:
                h.pop(0)
            if h:
                vals = sorted(x for _, x in h)
                m = vals[(len(vals) - 1) // 2]  # lower median: ties never favour a spike
                best = m if best is None else max(best, m)
        return best

    def clear(self):
        for h in self.hist:
            h.clear()


def curve_pct(lux, c):
    """log-lux curve with gamma between min and max (min defaults to 8 %)."""
    lo = c["min"]
    hi = max(lo, c["max"])
    lux = max(0.0, lux - c.get("darkLux", 0))
    x = math.log10(lux + 1) / math.log10(c["fullLux"] + 1)
    x = max(0.0, min(1.0, x)) ** c["gamma"]
    return lo + (hi - lo) * x


class Controller:
    """Pure logic (no I/O) so it can be simulated. Times in seconds."""

    def __init__(self, c):
        self.c = c
        self.stable = None        # filtered lux
        self.window = []          # (t, lux) candidates differing from stable
        self.offset = 0.0
        self.anchor = None        # lux when the offset was set
        self.offset_day = None
        self.ramp = None          # (t0, start, goal, duration)
        self.kbd_want = None
        self.kbd_dark = None      # (since, level) while waiting to turn the light on
        self.events = []

    def ev(self, t, msg):
        self.events.append((t, msg))

    def reset(self, t, why):
        if self.offset:
            self.ev(t, f"offset {self.offset:+.0f}% cleared ({why})")
        self.offset, self.anchor, self.stable, self.window = 0.0, None, None, []
        self.kbd_want = None
        self.kbd_dark = None
        self.ramp = None

    def feed_lux(self, t, lux):
        c = self.c
        if lux is None:
            return
        if self.stable is None:
            self.stable = lux
            self.window = []
            return
        ratio = (lux + 1) / (self.stable + 1)
        if abs(ratio - 1) < c["luxDeadband"] or abs(lux - self.stable) < c.get("luxAbsDeadband", 0):
            self.window = []
            return
        side = ratio > 1
        if self.window and self.window[0][2] != side:
            self.window = []
        jump = self.implausible(lux)
        self.window.append((t, lux, side, jump))
        if jump:
            # bogus HID bursts (0 -> 41008 lx for ~6 s in a dark room): accept
            # only if every sample of the last jumpSeconds is just as high
            run = []
            for w in reversed(self.window):
                if not w[3]:
                    break
                run.append(w)
            run.reverse()
            if t - run[0][0] < c.get("jumpSeconds", 10.0):
                return
            vals = sorted(w[1] for w in run)
            self.ev(t, f"sustained jump accepted after {t - run[0][0]:.0f}s")
        else:
            win = [w for w in self.window if not w[3]]
            # big drops (train tunnels/shadows: 250 -> 0 lx for 2-7 s) dim the
            # screen only once every sample held them for dimHoldSeconds;
            # brightening and small dims stay quick
            ratio = c.get("dimBigRatio", 0.5)
            big = lambda w: not w[2] and (w[1] + 1) / (self.stable + 1) < ratio
            if c.get("dimHoldSeconds", 0) and big(win[-1]):
                run = []
                for w in reversed(win):
                    if not big(w):
                        break
                    run.append(w)
                held = t - run[-1][0]
                if held < c["dimHoldSeconds"]:
                    quick = c.get("dimQuickSeconds", 0)
                    if quick and held >= quick and not getattr(self, "dim_staged", False):
                        vals = sorted(w[1] for w in run)
                        new = vals[len(vals) // 2]
                        mid = ((self.stable + 1) * (new + 1)) ** 0.5 - 1
                        self.ev(t, f"lux {self.stable:.1f} -> {mid:.1f} (quick dim, part-way to {new:.1f})")
                        self.stable = mid
                        self.dim_staged = True  # the run (and its start time) carries on
                    return
                win = run[::-1]
            elif c.get("dimHoldSeconds", 0):
                self.dim_staged = False
                win = [w for w in win if not big(w)]
            if t - win[0][0] < c["settleSeconds"]:
                return
            vals = sorted(w[1] for w in win)
        if True:
            new = vals[len(vals) // 2]
            self.ev(t, f"lux {self.stable:.1f} -> {new:.1f}")
            self.stable = new
            self.dim_staged = False
            self.window = []
            if self.anchor is not None and self.offset:
                r = (new + 1) / (self.anchor + 1)
                if r > c["offsetResetRatio"] or r < 1 / c["offsetResetRatio"]:
                    self.ev(t, f"offset {self.offset:+.0f}% cleared (light moved {r:.2f}x)")
                    self.offset, self.anchor = 0.0, None

    def implausible(self, lux):
        c, st = self.c, self.stable
        if st is None or st >= c.get("jumpDarkLux", 50.0):
            return False
        return lux > c.get("jumpFactor", 5.0) * st + c.get("jumpAbsLux", 500.0) or lux > c.get("jumpHugeLux", 20000.0)

    def manual(self, t, cur_pct, today):
        base = curve_pct(self.stable if self.stable is not None else 0, self.c)
        self.offset = cur_pct - base
        self.anchor = self.stable
        self.offset_day = today
        self.ramp = None
        self.ev(t, f"manual change to {cur_pct:.0f}% -> offset {self.offset:+.0f}% at {self.anchor or 0:.1f} lx")

    def new_day(self, t, today):
        if self.offset and self.offset_day != today:
            self.ev(t, f"offset {self.offset:+.0f}% cleared (new day)")
            self.offset, self.anchor = 0.0, None

    def target(self):
        if self.stable is None:
            return None
        return max(1.0, min(100.0, curve_pct(self.stable, self.c) + self.offset))

    def step(self, t, cur_pct, no_dim=False):
        """Return the brightness % to write now, or None."""
        want = self.target()
        if want is None:
            return None
        if no_dim and want < cur_pct:
            want = cur_pct
        if self.ramp and abs(self.ramp[2] - want) > 0.5:
            self.ramp = None
        if self.ramp is None:
            if abs(want - cur_pct) < 1.0:
                return None
            dur = self.c["brightenSeconds"] if want > cur_pct else self.c["dimSeconds"]
            self.ramp = (t, cur_pct, want, dur)
            self.ev(t, f"fade {cur_pct:.0f}% -> {want:.0f}% over {dur:g}s")
        t0, a, b, dur = self.ramp
        p = 1.0 if dur <= 0 else min(1.0, (t - t0) / dur)
        p = p * p * (3 - 2 * p)  # smoothstep: soft start and end
        if p >= 1.0:
            self.ramp = None
        return a + (b - a) * p

    def kbd_level(self, kbd_max, t=None):
        """Wanted keyboard level or None (= leave as is). Like a MacBook:
        light goes on (or up) only after the darkness lasted kbdOnSeconds,
        goes off (or down) as soon as it is bright again."""
        c, lux = self.c, self.stable
        if lux is None:
            return None
        l2 = c["kbdLevel2Below"]
        l2_exit = max(l2, c.get("kbdLevel2Exit", l2))
        if l2 and (lux < l2 or (self.kbd_want == 2 and lux <= l2_exit)):
            want = min(2, kbd_max)
        elif lux < c["kbdOnBelow"]:
            want = 1
        elif lux > c["kbdOffAbove"]:
            want = 0
        else:
            want = self.kbd_want  # dead zone: keep
        cur = self.kbd_want if self.kbd_want is not None else 0
        # 2.5.0: the quick part-way screen dim is not real darkness yet: the
        # keyboard light waits for the full dim (train dips stay unlit).
        if getattr(self, "dim_staged", False) and want is not None and want > cur:
            self.kbd_dark = None
            return self.kbd_want
        hold = c.get("kbdOnSeconds", 0)
        if t is None or not hold or want is None or want <= cur:
            self.kbd_dark = None
            return want
        # darker: (re)start the timer when the wanted level changes
        if self.kbd_dark is None or self.kbd_dark[1] != want:
            self.kbd_dark = (t, want)
        if t - self.kbd_dark[0] < hold:
            return self.kbd_want  # None (unknown) or current: no write yet
        self.kbd_dark = None
        return want


def find_dev(cls, pattern):
    hits = sorted(glob.glob(f"/sys/class/{cls}/{pattern}"))
    return hits[0] if hits else None


class Dev:
    def __init__(self, path):
        self.path, self.name = path, os.path.basename(path)
        self.max = int(read(path + "/max_brightness", "1") or 1)

    def get(self):
        return int(read(self.path + "/brightness", "0") or 0)

    def set(self, raw):
        # brightnessctl goes through logind (SetBrightness): no sudo.
        subprocess.run(["brightnessctl", "-q", "-d", self.name, "set", str(int(raw))], check=False)


def lid_closed():
    return any("closed" in (read(p) or "") for p in glob.glob("/proc/acpi/button/lid/*/state"))


_cache = {}


def cached(key, secs, fn):
    now = time.monotonic()
    hit = _cache.get(key)
    if hit and now - hit[0] < secs:
        return hit[1]
    try:
        v = fn()
    except Exception:
        v = False
    _cache[key] = (now, v)
    return v


def screen_off():
    """Every monitor DPMS-off (the lock screen's idle blank)."""
    def f():
        r = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3)
        mons = [m for m in json.loads(r.stdout or "[]") if not m.get("disabled")]
        return bool(mons) and not any(m.get("dpmsStatus", True) for m in mons)
    return cached("dpms", 2, f)


def locked():
    def f():
        r = subprocess.run(["qs", "ipc", "-p", "/usr/share/omarchy/shell", "call", "lock", "isLocked"],
                           capture_output=True, text=True, timeout=4)
        return r.stdout.strip() == "true"
    return cached("lock", 10, f)


def media_playing():
    """Any MPRIS player Playing (browsers, mpv, spotify...)."""
    out = subprocess.run(["busctl", "--user", "--json=short", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                          "org.freedesktop.DBus", "ListNames"], capture_output=True, text=True, timeout=3).stdout
    names = [n for n in json.loads(out)["data"][0] if n.startswith("org.mpris.MediaPlayer2.")]
    for n in names:
        r = subprocess.run(["busctl", "--user", "get-property", n, "/org/mpris/MediaPlayer2",
                            "org.mpris.MediaPlayer2.Player", "PlaybackStatus"], capture_output=True, text=True, timeout=3)
        if '"Playing"' in r.stdout:
            return True
    return False


def fullscreen():
    r = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=3)
    try:
        return bool(json.loads(r.stdout or "{}").get("fullscreen"))
    except ValueError:
        return False


def fullscreen_video():
    return cached("fsv", 3, lambda: fullscreen() and media_playing())


def write_state(d):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.replace(tmp, STATE)


def log(*a):
    print(*a, flush=True)


def run():
    sens = sensors()
    bl_path = find_dev("backlight", "*")
    if not sens or not bl_path:
        log("no ambient light sensor or backlight found; exiting")
        return 1
    bl = Dev(bl_path)
    kp = find_dev("leds", "*kbd_backlight")
    kbd = Dev(kp) if kp else None
    log(f"sensors={[p for p, _ in sens]} backlight={bl.name} kbd={kbd.name if kbd else None}")
    c = load_conf()
    ctl = Controller(c)
    filt = SensorFilter(len(sens), c["sensorMedianSeconds"])
    held = False
    conf_mtime = None
    last_set = None          # raw we last wrote
    was_closed = False
    last_wall, last_mono = time.time(), time.monotonic()
    reason = ""
    while True:
        m = os.path.getmtime(CONF) if os.path.exists(CONF) else None
        if m != conf_mtime:
            c, conf_mtime = load_conf(), m
            ctl.c = c
        t = time.monotonic()
        # resume detection: wall clock jumped further than the monotonic one
        wall = time.time()
        if (wall - last_wall) - (t - last_mono) > 20:
            ctl.reset(t, "resume")
            filt.clear()
            last_set = None
        last_wall, last_mono = wall, t
        closed = lid_closed()
        if was_closed and not closed:
            ctl.reset(t, "lid opened")
            filt.clear()
            last_set = None
        was_closed = closed
        ctl.new_day(t, datetime.date.today().isoformat())
        ctl.feed_lux(t, filt.feed(t, lux_once(sens)))
        for et, msg in ctl.events:
            log(msg)
        ctl.events.clear()

        if not c["enabled"]:
            reason = "off"
        elif closed:
            reason = "lid closed"
        elif os.path.exists(HOLD_FLAG):
            reason = "walk-away dim"
        elif screen_off():
            # The lock screen blanks via DPMS and saves/restores the keyboard
            # light itself. While locked but lit we keep adjusting (the lock
            # screen used to freeze at the old level, keyboard dark).
            reason = "screen off"
        elif ctl.stable is None:
            reason = "no reading"
        else:
            reason = "auto"

        cur = bl.get()
        busy = False
        if reason == "auto" and held:
            # coming back from a hold (screen off, walk-away, lid): re-apply the
            # keyboard level, since others (lock blank/restore) changed it
            ctl.kbd_want = None
        held = reason != "auto"
        if reason == "auto":
            if last_set is not None and abs(cur - last_set) > bl.max * 0.015:
                ctl.manual(t, cur / bl.max * 100, datetime.date.today().isoformat())
            pct = ctl.step(t, cur / bl.max * 100, no_dim=fullscreen_video())
            if pct is not None:
                raw = max(1, round(pct / 100 * bl.max))
                if raw != cur:
                    bl.set(raw)
                cur = raw
            busy = ctl.ramp is not None
            last_set = cur
            if kbd and c["keyboard"]:
                want = ctl.kbd_level(kbd.max, t)
                # only act on transitions, so the firmware idle-off and the
                # user's own key presses are never overridden
                if want is not None and want != ctl.kbd_want:
                    log(f"lux={ctl.stable:.1f} keyboard -> {want}")
                    kbd.set(want)
                    ctl.kbd_want = want
            for et, msg in ctl.events:
                log(msg)
            ctl.events.clear()
        else:
            last_set = None
            ctl.ramp = None

        write_state({
            "enabled": c["enabled"], "min": c["min"], "max": c["max"], "keyboard": c["keyboard"],
            "lux": None if ctl.stable is None else round(ctl.stable, 1),
            "screen": round(bl.get() / bl.max * 100),
            "target": None if ctl.target() is None else round(ctl.target()),
            "offset": round(ctl.offset), "mode": reason,
        })
        time.sleep(0.1 if busy else 0.5)


def describe_sensors():
    out = []
    for d in sorted(glob.glob("/sys/bus/iio/devices/iio:device*")):
        name = read(d + "/name")
        if name != "als":
            continue
        ch = sorted({os.path.basename(p).split("_")[1] for p in glob.glob(d + "/in_*_raw") + glob.glob(d + "/in_*_input")})
        info = {"device": os.path.basename(d), "channels": ch}
        sc = lambda n: float(read(f"{d}/in_{n}_scale", "1") or 1)
        if "colortemp" in ch:
            info["colortempK"] = round(float(read(d + "/in_colortemp_raw", "0")) * sc("colortemp"))
        if "chromaticity" in ch:
            info["chromaticityXY"] = [round(float(read(f"{d}/in_chromaticity_{a}_raw", "0")) * sc("chromaticity"), 3) for a in "xy"]
        out.append(info)
    return out


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "run":
        return run() or 0
    if cmd == "lux":
        print(lux_now(sensors()))
        return 0
    if cmd == "sensors":
        print(json.dumps(describe_sensors(), indent=1))
        return 0
    c = load_conf()
    if cmd in ("on", "off", "toggle"):
        c["enabled"] = (cmd == "on") or (cmd == "toggle" and not c["enabled"])
        save_conf(c)
    elif cmd == "set" and len(argv) == 4:
        k, v = argv[2], argv[3]
        if k in ("min", "max"):
            c[k] = int(float(v))
        elif k in ("keyboard", "kbd"):
            c["keyboard"] = v in ("on", "1", "true")
        else:
            print(__doc__, file=sys.stderr)
            return 2
        save_conf(c)
        c = load_conf()
    elif cmd != "status":
        print(__doc__, file=sys.stderr)
        return 2
    try:
        with open(STATE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {"mode": "not running"}
    st.update({"enabled": c["enabled"], "min": c["min"], "max": c["max"], "keyboard": c["keyboard"]})
    print(json.dumps(st))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
