#!/usr/bin/env python3
"""Auto brightness from the laptop's own ambient light sensors (iio "als").

No camera, no habit learning. Works like a MacBook (details: README.md):
  - log-lux curve with gamma between your min and max
  - your own change becomes a +/- offset on the curve (no pause timer); the
    offset is dropped when the room light moves >2.5x from where you set it,
    after resume / lid open, or on the next day
  - fades 1.5-5 s up and 5-10 s down, sized by the change (Apple ramps); a big
    drop (sensor covered, lights off) dims part-way first, fully after 8 s
  - ignores light changes under 12 % / 2 lx and anything shorter than ~2 s;
    filters the XPS HID sensor's bursts, 0 lx drop-outs and impossible values;
    reads one light sensor (the plain one, not the colour view of it)
  - never dims while a fullscreen video plays
  - keyboard light: native levels only, auto uses level 1 at most (kbdMaxLevel,
    like macOS's ~25 % keys in the dark), on below 4 lx once the darkness held,
    off above 12 lx at once; a key press sticks, also across a lock blank; the
    Dell firmware's own inactivity timeout turns it off and the next key press
    turns it back on (we never fight that)
  - sensors read once a second in a background thread,
    brightness written 60x a second while fading
  - replaces other automatic brightness while it runs (omarchy-brightness-auto,
    wluma, Omarchy's keyboard auto): stopped for the session, never disabled

  omarchy-auto-brightness run          the daemon (systemd user service)
  omarchy-auto-brightness status       JSON state (for the bar widget)
  omarchy-auto-brightness on|off       enable / disable
  omarchy-auto-brightness set KEY VAL  min|max|keyboard|kbd-max (highest keyboard level auto sets, default 1)
  omarchy-auto-brightness kbd-level N  keyboard light to 0/1/2 now (auto may change it again later)
  omarchy-auto-brightness lux          print current lux once
  omarchy-auto-brightness sensors      which light sensor it reads
  omarchy-auto-brightness debug-log on|off  detailed decision log (off by default)
  omarchy-auto-brightness restore-replaced  start the auto-brightness services it stopped (uninstall)
"""
import datetime, fcntl, glob, json, math, os, shutil, signal, subprocess, sys, time

HOME = os.environ.get("HOME", "")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "omarchy", "auto-brightness.json")
RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
STATE = os.path.join(RUN, "omarchy-auto-brightness.json")
LOGDIR = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "omarchy-auto-brightness")
DLOG = os.path.join(LOGDIR, "decisions.jsonl")
HOLD_FLAG = os.path.join(RUN, "omarchy-walk-away.dimmed")  # walk-away lock owns the screen
WATCH_FLAG = os.path.join(RUN, "omarchy-auto-brightness.watch")  # 2.12.0: the popup is open (touched every 1 s)
# 2.16.0: other auto-brightness services this plugin replaces while it runs
# (like an Omarchy plugin with "clonedFrom"). Stopped for the session only,
# never disabled or masked; `restore-replaced` (uninstall.sh) starts them again.
REPLACES_SCREEN = ("omarchy-brightness-auto.service",   # omacom/omarchy#8025
                   "wluma.service")                     # omacom/omarchy-mac-pkgs#144 (runs wluma)
REPLACES_KBD = ("omarchy-brightness-keyboard-auto.service",)  # omacom/omarchy#14557, omarchy-mac-pkgs#142
REPLACED = os.path.join(RUN, "omarchy-auto-brightness.replaced")  # units stopped this session
# omacom/omarchy#13148 runs inside the shell and has an off flag instead of a unit
KBD_TOGGLE = os.path.join(HOME, ".local/state/omarchy/toggles/keyboard-backlight-auto-off")
KBD_TOGGLE_MINE = os.path.join(LOGDIR, "keyboard-toggle-set-by-auto-brightness")

DEFAULTS = {
    "enabled": True,
    "min": 8,              # screen %, darkest room (your slider is the real floor)
    "max": 100,            # screen %, sunlight
    "gamma": 0.8,          # <1 lifts the dim end of the curve
    "fullLux": 10000,      # lux that maps to max
    "keyboard": True,
    "kbdOnBelow": 4,       # lux: keyboard level 1 below this (XPS 14 sensors: lit room ~16-35 lx)
    "kbdMaxLevel": 1,      # 2.16.0: highest level auto sets (1 = about half on the XPS 14; macOS keeps
                           # the keys at ~25 % in the dark). 2 lets auto use level 2 below kbdLevel2Below.
                           # A key press to a higher level is never undone.
    "kbdLevel2Below": 1,   # lux: level 2 below this (very dark; 0 = never; only with kbdMaxLevel 2+)
    "kbdLevel2Exit": 2,    # lux: and back to level 1 only above this (hysteresis)
    "kbdOffAbove": 12,     # lux: off above this
    "kbdLowBatteryPercent": 15,  # 2.15.0: on battery below this %, auto sets the keyboard to level 1 at most (0 = off);
                                 # 2.16.0: only does something when kbdMaxLevel is above 1
    "kbdOnSeconds": 3.0,   # darker keyboard level only after the darkness held this long; big drops
                           # already wait dimHoldSeconds, so a lasting 250 -> 0 lx drop lights it after ~15 s
    "dimHoldSeconds": 8.0,   # a drop to under half the light must hold this long before the screen dims fully
    "dimQuickSeconds": 2.5,  # 2.5.0: ...but after this long it already dims part-way (half the drop, in
                             # log-lux), so covering the sensor shows a reaction in ~6.5 s; short dips
                             # (2-7 s) dim only part-way and come back in 1.5 s (Android: darkening 8 s)
    "dimBigRatio": 0.5,
    "brightenSeconds": 1.5,  # 2.6.0: fastest brighten (2x or more); see ramp_seconds()
    "dimSeconds": 4.0,       # 2.5.0: fade down, used only with "appleRamps": false
    "appleRamps": True,      # 2.6.0: ramp length from the size of the change, Apple patent
                             # US 2012/0019493: dim 1.5x/3x in ~5 s, 10x in ~10 s; brighten
                             # 1.5x in ~5 s, 2x or more in 1-2 s (eyes adapt slower to dark)
    "darkSlowLux": 10.0,     # 2.6.0: below this the settle wait grows (US 10,235,970: adjust
    "darkSlowFactor": 1.0,   # slower in the dark, less so as it brightens): +100 % at 0 lx
    "luxDeadband": 0.12,   # ignore lux changes smaller than 12 %
    "luxAbsDeadband": 2.0, # ...and smaller than 2 lx (dark end: sensor wobbles 0 <-> 1 lx)
    "darkLux": 2.0,        # the curve treats 0..2 lx as fully dark (no 12-point step at 1 lx)
    "settleSeconds": 2.0,  # a change must last this long (spikes, shadows)
    "offsetResetRatio": 2.5,
    "zeroTrustSeconds": 3.5,   # 2.10.0: an exact 0 lx is a HID dropout until it held this long (seen: up to 2.5 s)...
    "faintLux": 5.0,           # 2.16.4: ...when a faint real reading (0 < lux <= this) came just before: lights off.
                               # Every logged real lights-off read 1-5 lx first (the screen lights the room a little)
    "zeroDropoutSeconds": 60.0,  # 2.16.0: otherwise zeros wait this long, at any light level (2.16.4: also below 20 lx,
                                 # where 2.16.3 believed them at once: a 16 lx room dimmed to 1 % for 40 s).
                                 # 2.16.2: was 20 s; logged dropouts in a lit room lasted 27-45 s
    "zeroDarkSeconds": 10.0,     # ...a faint reading this long before the zeros started still counts
    "sensorMedianSeconds": 4.0,  # median: drops the XPS HID sensors' bogus 1-2 s bursts (0 -> 40000 lx)
    "jumpSeconds": 10.0,   # an implausible jump (dark -> sunlight) must hold this long, every sample high
    "jumpDarkLux": 50.0,   # "dark" stable value for the jump rule
    "jumpFactor": 5.0,     # implausible: from < jumpDarkLux to > jumpFactor*stable + jumpAbsLux
    "jumpAbsLux": 500.0,
    "jumpHugeLux": 20000.0,  # ...or above this from a dark stable value
    "wakeSeconds": 3.0,      # 2.7.0: after resume / lid open, follow the sensor at once for this long
    "wakeFadeSeconds": 0.4,  # ...with short fades, and set the keyboard light without waiting
    "wakeDarkLux": 10.0,     # 2.16.0: waking in a room darker than this, the screen still dims at once but
                             # brightens with the normal (slower) fade (Apple US 8,743,161 / US 11,755,143, luminescence shock avoidance)
    "kbdRestoreSeconds": 1.0,  # 2.16.0: after a blank, resume or lid open, the keyboard waits this long
                               # (and for Omarchy's `omarchy-brightness-keyboard restore`) before deciding
    "kbdRestoreMaxSeconds": 6.0,  # ...but never longer than this for a restore that never comes
    "sampleSeconds": 1.0,    # 2.16.5: once a second, also while fading and with the popup open (was 0.5 / 0.25).
                             # At 2 Hz the XPS sensor firmware stuck at 0 lx: a gap under about 0.45 s after a
                             # read ended left it answering 0 until a longer gap. Brightness writes stay at 60 Hz
    "popupSampleSeconds": 1.0,  # same while the popup is open (was 0.25)
    "sampleMinGapSeconds": 0.9,  # 2.16.5: never start a read until this long after the last one ended
    "returnSeconds": 120.0,  # 2.16.0: a dark -> bright jump back to (about) the light of the last
                             # this-many seconds is a return, not a "sustained jump" that must hold jumpSeconds
    "glitchQuarantineSeconds": 30.0,  # 2.8.0: a sensor that just reported an impossible value
                                      # (> MAX_LUX, e.g. 170063 lx) is ignored this long
    "disagreeRatio": 20.0,   # 2.8.0: one sensor > jumpHugeLux while the other says < jumpDarkLux
                             # (and 20x lower): a single-sensor HID burst, use the lower one
    "glitchEpisodeSeconds": 90.0,  # 2.8.1: after any impossible value, no dark -> >jumpHugeLux jump
    "logMaxBytes": 1000000,  # 2.8.0: decision log size cap (one rotated copy kept)
    "debugLog": False,       # 2.16.6: off = errors, sensor faults and state changes only;
                             # on = every decision (lux, heartbeats, fades) as before
    "previewSeconds": 2.0,       # 2.12.0: after a min/max change, follow it at once this long...
    "previewFadeSeconds": 0.15,  # ...with fades this short (slider drag in the popup)
}
MAX_LUX = 60000
STALE_SECONDS = 30  # a state file older than this was left by a daemon that is not running
VERSION = "2.16.6"


def load_conf():
    c = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            c.update(json.load(f))
    except (OSError, ValueError):
        pass
    c["min"] = max(1, min(100, int(c["min"])))
    c["max"] = max(c["min"], min(100, int(c["max"])))
    v = c.get("debugLog", False)
    c["debugLog"] = v is True or v in (1, "on", "true", "1")
    return c


def save_conf(c, extra=()):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    keep = {k: c[k] for k in ("enabled", "min", "max", "keyboard", *extra) if k in c}
    try:
        with open(CONF) as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = {}
    old.update(keep)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        json.dump(old, f, indent=2)
        f.write("\n")
    os.replace(tmp, CONF)


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


IIO = "/sys/bus/iio/devices"


def sensor():
    """(file, scale) of the ambient light sensor, or None. 2.16.4: the plain
    illuminance sensor only. The XPS also lists a colour view of the same
    chip (colour temperature, chromaticity); reading both doubled the traffic
    to the sensor hub and its 0 lx dropouts, and added nothing."""
    found = []
    for d in sorted(glob.glob(IIO + "/iio:device*")):
        if read(d + "/name") != "als":
            continue
        if not (os.path.exists(d + "/in_illuminance_input") or os.path.exists(d + "/in_illuminance_raw")):
            continue
        colour = glob.glob(d + "/in_colortemp_*") or glob.glob(d + "/in_chromaticity_*")
        found.append((bool(colour), d))
    if not found:
        return None
    d = min(found)[1]  # plain before colour, then by device name
    if os.path.exists(d + "/in_illuminance_input"):
        return d + "/in_illuminance_input", 1.0
    return d + "/in_illuminance_raw", float(read(d + "/in_illuminance_scale", "1") or 1)


def lux_raw(sens):
    """One raw sample in lux (None = unreadable), not range-checked."""
    try:
        return float(read(sens[0])) * sens[1]
    except (TypeError, ValueError):
        return None


READER_THREAD = True  # tests with a fake clock read inline instead


class SensorReader:
    """2.16.0: reads the light sensor at most every `interval` seconds.
    2.16.5: once a second, also with the popup open, and never starts a read
    until `min_gap` (0.9 s) after the last one ended. The XPS sensor firmware
    sticks at 0 lx when that gap is under about 0.45 s, and stays stuck until
    a longer gap. Each sysfs read is a round trip to the sensor hub (0.1 s
    measured, the kernel waits up to 5 s). A background thread reads, the
    loop takes the newest sample (or None). A wake flush still asks for a
    fresh read, but only after the gap."""

    def __init__(self, sens, threaded=None):
        import threading
        self.sens, self.interval, self.min_gap = sens, 1.0, 0.9
        self.threaded = READER_THREAD if threaded is None else threaded
        self.last = None      # (t, sample, ms) not taken yet
        self.read_at = None   # inline: when we last started a read
        self.last_end = None  # when the last read ended (monotonic, or the fake clock)
        self.ms = None
        self.stale = -1e18    # samples read before this (monotonic) are dropped
        if self.threaded:
            self.lock, self.wake = threading.Lock(), threading.Event()
            threading.Thread(target=self._loop, name="sensors", daemon=True).start()

    def _gap(self):
        return max(0.9, float(self.min_gap))

    def _read(self):
        t0 = time.monotonic()
        v = lux_raw(self.sens)
        return time.monotonic(), v, round((time.monotonic() - t0) * 1000)

    def _loop(self):
        while True:
            now = time.monotonic()
            if self.last_end is not None:
                left = self._gap() - (now - self.last_end)
                if left > 0:
                    time.sleep(left)
            t0 = time.monotonic()
            got = self._read()
            self.last_end = time.monotonic()
            with self.lock:
                if t0 >= self.stale:
                    self.last = got
            remain = self.interval - (self.last_end - t0)
            if remain > 0:
                self.wake.wait(remain)
                self.wake.clear()

    def flush(self, t):
        """Forget what was read before t (resume, lid open) and read again
        as soon as the 0.9 s gap allows."""
        if self.threaded:
            with self.lock:
                self.stale, self.last = t, None
            self.wake.set()
        else:
            self.read_at = None

    def take(self, t):
        """(t, sample, ms) read since the last take, or None."""
        if not self.threaded:
            if self.read_at is not None and t - self.read_at < self.interval - 1e-6:
                return None
            if self.last_end is not None and t - self.last_end < self._gap() - 1e-6:
                return None
            self.read_at = t
            _, sample, ms = self._read()
            self.last_end = t
            self.ms = ms
            return t, sample, ms
        with self.lock:
            got, self.last = self.last, None
        if got is not None:
            self.ms = got[2]
        return got


def lux_now(sens):
    v = lux_raw(sens) if sens else None
    return v if v is not None and 0 <= v <= MAX_LUX else None


def time_median(h):
    """Lower median of (t, lux) readings, each weighted by how long it lasted
    (until the next reading; the newest as long as the gap before it). The
    daemon samples at 60 Hz while fading and at 1 Hz otherwise, so counting
    samples let a 2 s burst during a fade outvote the calm readings before it.
    Ties go to the lower value, so a spike never wins half the window."""
    if not h:
        return None
    ts = [x[0] for x in h]
    gaps = [b - a for a, b in zip(ts, ts[1:])]
    weights = gaps + [gaps[-1] if gaps else 1.0]
    total = sum(weights)
    acc = 0.0
    for v, w in sorted(zip((x[1] for x in h), weights)):
        acc += w
        if acc >= total / 2 - 1e-9:
            return v
    return v


class SensorFilter:
    """Rolling median over `secs` of the light sensor's readings.
    The XPS 14 HID light sensor sometimes reports a burst of 0.5-1.5 s of
    garbage (tens of thousands of lux in a dark room), so a raw sample saw a
    >2 s 'sunlight' spike. A median needs a change to hold for over half the
    window. Impossible values quarantine the sensor and exact zeros are
    suspect (2.16.4: one sensor, so no second sensor to compare with)."""

    def __init__(self, secs, c=None):
        self.secs, self.hist = secs, []
        self.c = c if c is not None else DEFAULTS
        self.bad_until = -1e9         # 2.8.0: quarantine after an impossible value
        self.median = None
        self.standing = set()
        self.last_out = None          # 2.8.1: last value handed to the controller
        self.note = ""                # why the sensor was ignored this sample (for the log)
        self.zero_since = None        # 2.10.0: start of a run of exact-0 samples
        self.last_glitch = None       # last sample inside a glitch episode
        self.live = None              # 2.12.0: this sample's lux, glitch rules but no median (popup)
        self.last_median = None       # 2.16.0: last median, kept through a quarantine
        self.dim_seen = None          # 2.16.0: last faint real reading (the room really is dark)
        self.zero_fault = False       # 2.16.6: this zero run is a stuck-zero episode (logged once)

    def feed(self, t, v):
        """v: raw lux (None = unreadable). Values outside 0..MAX_LUX are HID
        garbage: they quarantine the sensor for a while. Returns the lux the
        controller should see, or None (hold)."""
        c, notes, h = self.c, [], self.hist
        q = c["glitchQuarantineSeconds"]
        # 2.16.0: a faint but real reading (0 < lux <= faintLux) from the
        # sensor in good standing is evidence that the room really is dark
        if v is not None and 0 < v <= c["faintLux"] and t >= self.bad_until:
            self.dim_seen = t
        if v is not None and not (0 <= v <= MAX_LUX):
            if t >= self.bad_until:
                notes.append(f"sensor impossible {v:.0f} lx, quarantined {q:.0f}s")
            self.bad_until = t + q
            h.clear()
            v = None
        # 2.10.0: the XPS HID sensor keeps dropping to exactly 0 in an
        # unchanged room. The kernel's HID sensor read returns 0 when the
        # sensor hub sends no value (drivers/hid/hid-sensor-hub.c), so an
        # exact 0 next to a non-zero reading means "no data", not darkness.
        # 2.16.4: that holds at any light level (logged: 16 lx -> 1 % for
        # 40 s). Exact zeros wait zeroDropoutSeconds, unless a faint real
        # reading came just before (lights off): then zeroTrustSeconds. With
        # no non-zero reading to hold on to, a zero is just the reading.
        ref = self.median if self.median is not None else self.last_median
        if v == 0:
            if self.zero_since is None:
                self.zero_since = t
            if ref is not None and 0 < ref <= c["jumpHugeLux"]:  # (above that it is a burst, not a room)
                dark = self.dim_seen is not None and self.dim_seen >= self.zero_since - c["zeroDarkSeconds"]
                wait = c["zeroTrustSeconds"] if dark else c["zeroDropoutSeconds"]
                if t - self.zero_since < wait:
                    v = None
                else:
                    h.clear()  # held long enough: drop the old light samples at once
                # 2.16.6: a dropout-path zero run (not a real lights-off) is a
                # sensor fault; note it once after it has lasted a bit
                if wait == c["zeroDropoutSeconds"] and not self.zero_fault:
                    held = t - self.zero_since
                    if held >= min(10.0, c["zeroDropoutSeconds"]):
                        notes.append(f"sensor stuck at 0 lx for {held:.0f}s")
                        self.zero_fault = True
        elif v is not None:
            if self.zero_fault and self.zero_since is not None:
                notes.append(f"sensor 0 lx ended after {t - self.zero_since:.0f}s")
            self.zero_fault = False
            self.zero_since = None
        if v is not None:
            h.append((t, v))
        while h and t - h[0][0] > self.secs:
            h.pop(0)
        self.median = time_median(h)
        if self.median is not None:
            self.last_median = self.median
        best = self.median if t >= self.bad_until else None  # quarantined: hold
        # 2.8.1: during a glitch episode (the sensor went impossible in the
        # last glitchEpisodeSeconds) a dark -> sunlight jump is not believed at all
        if t < self.bad_until + c["glitchEpisodeSeconds"]:
            self.last_glitch = t
        live = self.live_lux(t, v)
        if live is not None:
            self.live = live
        if (best is not None and self.last_glitch == t
                and self.last_out is not None and self.last_out < c["jumpDarkLux"]
                and best > c["jumpHugeLux"]):
            notes.append(f"glitch episode, ignoring {best:.0f} lx")
            best = self.last_out
        if best is not None:
            self.last_out = best
        # repeat-free: a standing condition is noted once, when it starts
        cond = [n for n in notes if not n.startswith("sensor")]
        new = [n for n in notes if n.startswith("sensor")] + [n for n in cond if n.split(" (")[0] not in self.standing]
        self.standing = {n.split(" (")[0] for n in cond}
        self.note = "; ".join(new)
        return best

    def live_lux(self, t, v):
        """Lux from this sample alone, for the popup: the same rules (range,
        quarantine, 0 lx drop-outs, glitch episode) but no median, so it
        follows the room at once. None when the sample is not usable."""
        c = self.c
        if v is None or t < self.bad_until:
            return None
        if (self.last_glitch == t and self.live is not None and self.live < c["jumpDarkLux"]
                and v > c["jumpHugeLux"]):
            return self.live
        return v

    def clear(self):
        """Fresh start (resume, lid open): forget the old room."""
        self.hist.clear()
        self.median = self.last_median = self.zero_since = self.dim_seen = None
        self.zero_fault = False


def curve_pct(lux, c):
    """log-lux curve with gamma between min and max (min defaults to 8 %)."""
    lo = c["min"]
    hi = max(lo, c["max"])
    lux = max(0.0, lux - c["darkLux"])
    x = math.log10(lux + 1) / math.log10(c["fullLux"] + 1)
    x = max(0.0, min(1.0, x)) ** c["gamma"]
    return lo + (hi - lo) * x


class Controller:
    """Pure logic (no I/O) so it can be simulated. Times in seconds."""

    def __init__(self, c):
        self.c = c
        self.stable = None        # filtered lux
        self.window = []          # (t, lux) candidates differing from stable
        self.offset = 0.0
        self.anchor = None        # lux when the offset was set
        self.offset_day = None
        self.ramp = None          # (t0, start, goal, duration)
        self.kbd_want = None
        self.kbd_dark = None      # (since, level) while waiting to turn the light on
        self.staged_to = None     # lux a big drop is heading for while only its part-way dim is applied
        self.wake_until = -1.0    # follow the sensor at once until then (resume / lid open)
        self.screen_wake_until = -1.0  # 2.16.0: short fades until then (the screen came back from a blank)
        self.preview_until = -1.0  # 2.12.0: a min/max change is followed at once until then
        self.bright_before = None  # 2.16.0: (t, lux) the last time a lit room went dark
        self.events = []

    @property
    def dim_staged(self):
        return self.staged_to is not None

    def ev(self, t, msg):
        self.events.append((t, msg))

    def reset(self, t, why):
        if self.offset:
            self.ev(t, f"offset {self.offset:+.0f}% cleared ({why})")
        self.offset, self.anchor, self.stable, self.window = 0.0, None, None, []
        self.kbd_want = None
        self.kbd_dark = None
        self.ramp = None
        self.staged_to = None
        self.bright_before = None
        self.wake_until = t + self.c["wakeSeconds"]  # 2.7.0: fresh read on wake

    def waking(self, t):
        return t is not None and t < self.wake_until

    def feed_lux(self, t, lux):
        before = self.stable
        self._feed_lux(t, lux)
        dark = self.c["jumpDarkLux"]
        if before is not None and before >= dark and self.stable is not None and self.stable < dark:
            self.bright_before = (t, before)  # 2.16.0: for returnSeconds

    def _feed_lux(self, t, lux):
        c = self.c
        if lux is None:
            return
        if self.stable is None or self.waking(t):
            # 2.7.0: right after resume the first samples can still be the
            # pre-suspend value; follow every new reading without settle waits
            if self.stable is not None and abs(lux - self.stable) >= 0.05:
                self.ev(t, f"lux {self.stable:.1f} -> {lux:.1f} (wake)")
            self.stable = lux
            self.window = []
            self.staged_to = None
            return
        ratio = (lux + 1) / (self.stable + 1)
        if abs(ratio - 1) < c["luxDeadband"] or abs(lux - self.stable) < c["luxAbsDeadband"]:
            self.window = []
            if self.dim_staged and lux != self.stable:
                # the reading is within the deadband of the part-way value:
                # finish the dim at the real reading (a dim room going dark
                # stopped at ~1.2 lx and never reached keyboard level 2)
                self.ev(t, f"lux {self.stable:.1f} -> {lux:.1f} (part-way dim finished)")
                self.stable = lux
            self.staged_to = None
            return
        side = ratio > 1
        if self.window and self.window[0][2] != side:
            self.window = []
        jump = self.implausible(lux, t)
        self.window.append((t, lux, side, jump))
        if jump:
            # bogus HID bursts (0 -> 41008 lx for ~6 s in a dark room): accept
            # only if every sample of the last jumpSeconds is just as high
            run = []
            for w in reversed(self.window):
                if not w[3]:
                    break
                run.append(w)
            run.reverse()
            if t - run[0][0] < c["jumpSeconds"]:
                return
            vals = sorted(w[1] for w in run)
            self.ev(t, f"sustained jump accepted after {t - run[0][0]:.0f}s")
        else:
            win = [w for w in self.window if not w[3]]
            # big drops (shadows, sensor drop-outs: 250 -> 0 lx for 2-7 s) dim the
            # screen only once every sample held them for dimHoldSeconds;
            # brightening and small dims stay quick
            ratio = c["dimBigRatio"]
            big = lambda w: not w[2] and (w[1] + 1) / (self.stable + 1) < ratio
            if c["dimHoldSeconds"] and big(win[-1]):
                run = []
                for w in reversed(win):
                    if not big(w):
                        break
                    run.append(w)
                held = t - run[-1][0]
                if held < c["dimHoldSeconds"]:
                    quick = c["dimQuickSeconds"]
                    if quick and held >= quick and not self.dim_staged:
                        vals = sorted(w[1] for w in run)
                        new = vals[len(vals) // 2]
                        mid = ((self.stable + 1) * (new + 1)) ** 0.5 - 1
                        self.ev(t, f"lux {self.stable:.1f} -> {mid:.1f} (quick dim, part-way to {new:.1f})")
                        self.stable = mid
                        self.staged_to = new  # the run (and its start time) carries on
                    return
                win = run[::-1]
            elif c["dimHoldSeconds"]:
                self.staged_to = None
                win = [w for w in win if not big(w)]
            if t - win[0][0] < self.settle_seconds(not win[-1][2]):
                return
            vals = sorted(w[1] for w in win)
        new = vals[len(vals) // 2]
        self.ev(t, f"lux {self.stable:.1f} -> {new:.1f}")
        self.stable = new
        self.staged_to = None
        self.window = []
        if self.anchor is not None and self.offset:
            r = (new + 1) / (self.anchor + 1)
            if r > c["offsetResetRatio"] or r < 1 / c["offsetResetRatio"]:
                self.ev(t, f"offset {self.offset:+.0f}% cleared (light moved {r:.2f}x)")
                self.offset, self.anchor = 0.0, None

    def settle_seconds(self, darker=True):
        """settleSeconds, longer in the dark (linear: x(1+darkSlowFactor) at 0 lx, x1 at darkSlowLux).
        Only for changes toward darker: coming back into the light stays quick."""
        c = self.c
        if not darker:
            return c["settleSeconds"]
        base, dl = c["settleSeconds"], c["darkSlowLux"]
        if not dl or self.stable is None or self.stable >= dl:
            return base
        return base * (1 + c["darkSlowFactor"] * (1 - self.stable / dl))

    def ramp_seconds(self, a, b):
        """Fade length for a -> b (screen %)."""
        c = self.c
        up = b > a
        if not c["appleRamps"]:
            return c["brightenSeconds"] if up else c["dimSeconds"]
        r = max(a, b, 1.0) / max(min(a, b), 1.0)
        lg = math.log
        if up:  # 1.5x -> 5 s, 2x and more -> brightenSeconds (1.5 s), log-interpolated
            f = min(1.0, max(0.0, lg(r / 1.5) / lg(2 / 1.5)))
            return 5.0 + (c["brightenSeconds"] - 5.0) * f
        # dim: up to 3x -> 5 s, 10x and more -> 10 s
        f = min(1.0, max(0.0, lg(r / 3) / lg(10 / 3)))
        return 5.0 + 5.0 * f

    def implausible(self, lux, t=None):
        c, st = self.c, self.stable
        if st is None or st >= c["jumpDarkLux"]:
            return False
        if not (lux > c["jumpFactor"] * st + c["jumpAbsLux"] or lux > c["jumpHugeLux"]):
            return False
        # 2.16.0: back to about the light of a moment ago is a return, not a
        # dark -> sunlight HID burst: it brightens after the normal settle
        # time (a false dim at 1100 lx stayed at 1 % for 10 s waiting here)
        b = self.bright_before
        if (b is not None and t is not None and t - b[0] <= c["returnSeconds"]
                and lux <= b[1] * c["offsetResetRatio"] and lux <= c["jumpHugeLux"]):
            return False
        return True

    def manual(self, t, cur_pct, today):
        if self.staged_to is not None:
            # 2.10.2: a key press during the part-way dim answers the darkness
            # it is heading for: accept that now, so the pending full dim does
            # not clear the new offset and fade below what was just set
            self.ev(t, f"lux {self.stable:.1f} -> {self.staged_to:.1f} (part-way dim finished by manual change)")
            self.stable, self.staged_to, self.window = self.staged_to, None, []
        base = curve_pct(self.stable if self.stable is not None else 0, self.c)
        self.offset = cur_pct - base
        self.anchor = self.stable
        self.offset_day = today
        self.ramp = None
        self.ev(t, f"manual change to {cur_pct:.0f}% -> offset {self.offset:+.0f}% at {self.anchor or 0:.1f} lx")

    def new_day(self, t, today):
        if self.offset and self.offset_day != today:
            self.ev(t, f"offset {self.offset:+.0f}% cleared (new day)")
            self.offset, self.anchor = 0.0, None

    def target(self):
        if self.stable is None:
            return None
        return max(1.0, min(100.0, curve_pct(self.stable, self.c) + self.offset))

    def step(self, t, cur_pct, no_dim=False):
        """Return the brightness % to write now, or None."""
        want = self.target()
        if want is None:
            return None
        if no_dim and want < cur_pct:
            want = cur_pct
        if self.ramp and abs(self.ramp[2] - want) > 0.5:
            self.ramp = None
        if self.ramp is None:
            if abs(want - cur_pct) < 1.0:
                return None
            if t < self.preview_until:
                dur = self.c["previewFadeSeconds"]
            elif self.waking(t) or t < self.screen_wake_until:
                # 2.16.0: like a MacBook waking its display, match the room at
                # once, except brightening in a dark room (eyes adapted to the
                # dark): that takes the normal fade (Apple US 8,743,161)
                dark_up = want > cur_pct and self.stable < self.c["wakeDarkLux"]
                dur = self.ramp_seconds(cur_pct, want) if dark_up else self.c["wakeFadeSeconds"]
            else:
                dur = self.ramp_seconds(cur_pct, want)
            self.ramp = (t, cur_pct, want, dur)
            self.ev(t, f"fade {cur_pct:.0f}% -> {want:.0f}% over {dur:.1f}s")
        t0, a, b, dur = self.ramp
        p = 1.0 if dur <= 0 else min(1.0, (t - t0) / dur)
        p = p * p * (3 - 2 * p)  # smoothstep: soft start and end
        if p >= 1.0:
            self.ramp = None
            return b
        # 2.9.0: interpolate in log space (perceived brightness), like macOS:
        # equal-looking steps at 5% and at 80%, no fast visible jumps at the dim end.
        la, lb = math.log(max(a, 0.5)), math.log(max(b, 0.5))
        return math.exp(la + (lb - la) * p)

    def kbd_band(self, kbd_max, before=None):
        """2.16.0: the level the room asks for now, without timers (None =
        the 4-12 lx dead zone, keep). Capped at kbdMaxLevel and kbd_max.
        `before` is the level auto had chosen (for the level 2 hysteresis)."""
        c, lux = self.c, self.stable
        if lux is None:
            return None
        top = max(0, min(kbd_max, int(c["kbdMaxLevel"])))
        l2 = c["kbdLevel2Below"] if top >= 2 else 0
        if l2 and (lux < l2 or (before == 2 and lux <= max(l2, c["kbdLevel2Exit"]))):
            return min(2, top)
        if lux < c["kbdOnBelow"]:
            return min(1, top)
        if lux > c["kbdOffAbove"]:
            return 0
        return None

    def kbd_level(self, kbd_max, t=None):
        """Wanted keyboard level or None (= leave as is). Like a MacBook:
        light goes on (or up) only after the darkness lasted kbdOnSeconds,
        goes off (or down) as soon as it is bright again. Never above
        kbdMaxLevel (2.16.0: 1 by default)."""
        c, lux = self.c, self.stable
        if lux is None:
            return None
        kbd_max = max(0, min(kbd_max, int(c["kbdMaxLevel"])))
        l2 = c["kbdLevel2Below"] if kbd_max >= 2 else 0
        l2_exit = max(l2, c["kbdLevel2Exit"])
        if l2 and (lux < l2 or (self.kbd_want == 2 and lux <= l2_exit)):
            want = min(2, kbd_max)
        elif lux < c["kbdOnBelow"]:
            want = min(1, kbd_max)
        elif lux > c["kbdOffAbove"]:
            want = 0
        else:
            want = self.kbd_want  # dead zone: keep
        cur = self.kbd_want if self.kbd_want is not None else 0
        # 2.5.0: the quick part-way screen dim is not real darkness yet: the
        # keyboard light waits for the full dim (short dips stay unlit).
        if self.dim_staged and want is not None and want > cur:
            self.kbd_dark = None
            return self.kbd_want
        hold = 0 if self.waking(t) else c["kbdOnSeconds"]
        if t is None or not hold or want is None or want <= cur:
            self.kbd_dark = None
            return want
        # darker: (re)start the timer when the wanted level changes
        if self.kbd_dark is None or self.kbd_dark[1] != want:
            self.kbd_dark = (t, want)
        if t - self.kbd_dark[0] < hold:
            return self.kbd_want  # None (unknown) or current: no write yet
        self.kbd_dark = None
        return want


def find_dev(cls, pattern):
    hits = sorted(glob.glob(f"/sys/class/{cls}/{pattern}"))
    return hits[0] if hits else None


class Dev:
    def __init__(self, path):
        self.path, self.name = path, os.path.basename(path)
        self.max = int(read(path + "/max_brightness", "1") or 1)

    def get(self):
        return int(read(self.path + "/brightness", "0") or 0)

    _bus = None

    def set(self, raw):
        # logind SetBrightness (no sudo) over one kept D-Bus connection, so fades
        # can write ~60 times a second; brightnessctl (same call) as fallback.
        try:
            if Dev._bus is None:
                from gi.repository import Gio, GLib
                Dev._bus = (Gio.bus_get_sync(Gio.BusType.SYSTEM, None), GLib)
            bus, GLib = Dev._bus
            sub = os.path.basename(os.path.dirname(self.path))
            bus.call_sync("org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                          "org.freedesktop.login1.Session", "SetBrightness",
                          GLib.Variant("(ssu)", (sub, self.name, int(raw))), None, 0, 2000, None)
        except Exception:
            # 2.16.3: with a timeout, so a stuck fallback cannot stall the loop
            try:
                subprocess.run(["brightnessctl", "-q", "-d", self.name, "set", str(int(raw))],
                               capture_output=True, timeout=5)
            except Exception:
                pass


POWER_SUPPLY = "/sys/class/power_supply"


def battery():
    """(percent, discharging) of the laptop's own battery, or None. Skips
    peripheral batteries (mouse, headset: scope "Device")."""
    for d in sorted(glob.glob(POWER_SUPPLY + "/*")):
        if read(d + "/type") != "Battery" or read(d + "/scope", "System") == "Device":
            continue
        try:
            return int(read(d + "/capacity")), read(d + "/status") == "Discharging"
        except (TypeError, ValueError):
            continue
    return None


def low_battery(c):
    """2.15.0: discharging and under kbdLowBatteryPercent (read every 10 s)."""
    limit = c["kbdLowBatteryPercent"]
    if not limit:
        return False
    b = cached("battery", 10, battery)
    return bool(b) and b[1] and b[0] < limit


def lid_closed():
    return any("closed" in (read(p) or "") for p in glob.glob("/proc/acpi/button/lid/*/state"))


_cache = {}


def cached(key, secs, fn):
    now = time.monotonic()
    hit = _cache.get(key)
    if hit and now - hit[0] < secs:
        return hit[1]
    try:
        v = fn()
    except Exception:
        v = False
    _cache[key] = (now, v)
    return v


def screen_off():
    """Every monitor DPMS-off (the lock screen's idle blank)."""
    def f():
        r = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3)
        mons = [m for m in json.loads(r.stdout or "[]") if not m.get("disabled")]
        return bool(mons) and not any(m.get("dpmsStatus", True) for m in mons)
    return cached("dpms", 2, f)


def media_playing():
    """Any MPRIS player Playing (browsers, mpv, spotify...)."""
    out = subprocess.run(["busctl", "--user", "--json=short", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                          "org.freedesktop.DBus", "ListNames"], capture_output=True, text=True, timeout=3).stdout
    names = [n for n in json.loads(out)["data"][0] if n.startswith("org.mpris.MediaPlayer2.")]
    for n in names:
        r = subprocess.run(["busctl", "--user", "get-property", n, "/org/mpris/MediaPlayer2",
                            "org.mpris.MediaPlayer2.Player", "PlaybackStatus"], capture_output=True, text=True, timeout=3)
        if '"Playing"' in r.stdout:
            return True
    return False


def fullscreen():
    r = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=3)
    try:
        return bool(json.loads(r.stdout or "{}").get("fullscreen"))
    except ValueError:
        return False


def fullscreen_video():
    return cached("fsv", 3, lambda: fullscreen() and media_playing())


def popup_open():
    try:
        return time.time() - os.path.getmtime(WATCH_FLAG) < 2.5
    except OSError:
        return False


def _kb(path, key=None):
    try:
        with open(path) as f:
            if key is None:
                return int(f.read().strip()) // 1024
            for line in f:
                if line.startswith(key):
                    return int(line.split()[1])
    except (OSError, ValueError):
        pass
    return None


def mem_kb():
    """2.16.3: memory in KB for the decision log, to see a leak while it
    happens: the daemon's own RSS and swap, and the whole service's RAM and
    swap (children like hyprctl included). The service may not swap."""
    out = {"rss": _kb("/proc/self/status", "VmRSS:"), "swap": _kb("/proc/self/status", "VmSwap:")}
    try:
        with open("/proc/self/cgroup") as f:
            cg = "/sys/fs/cgroup" + f.read().strip().split("::", 1)[1]
        out["unit"] = _kb(cg + "/memory.current")
        out["unitSwap"] = _kb(cg + "/memory.swap.current")
    except (OSError, IndexError):
        pass
    return out


def write_state(d):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.replace(tmp, STATE)


def log(*a):
    print(*a, flush=True)


def default_log_event(msg):
    """2.16.6: events kept when the debug log is off: sensor faults (quarantine,
    stuck-zero episode), errors, and state changes (start, stop, mode)."""
    if not msg or msg == "heartbeat":
        return False
    if msg.startswith(("sensor ", "mode ", "error", "stop", "start", "glitch ")):
        return True
    return "quarantine" in msg


class DecisionLog:
    """2.8.0: structured JSON-lines log. 2.16.6: by default only faults and
    state changes; with debugLog, every decision (lux, heartbeats, fades).
    Size-capped either way: at logMaxBytes the file moves to
    decisions.jsonl.1 (one old copy kept)."""

    def __init__(self, path=DLOG, max_bytes=1000000):
        self.path, self.max = path, max_bytes
        self.last_beat = -1e9
        self.last_reason = None
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
        except OSError:
            pass

    def write(self, **rec):
        rec = {"ts": datetime.datetime.now().astimezone().isoformat(timespec="milliseconds"), **rec}
        try:
            if os.path.exists(self.path) and os.path.getsize(self.path) > self.max:
                os.replace(self.path, self.path + ".1")
            with open(self.path, "a") as f:
                f.write(json.dumps(rec, separators=(",", ":")) + "\n")
        except OSError:
            pass


def hold_reason(enabled, lid_closed, walk_away, screen_off, have_reading):
    """Why the daemon is not adjusting ("auto" = adjusting). Being locked is
    deliberately not a reason: on the lock screen brightness keeps following
    the light. Only a DPMS-off screen (the lock screen's idle blank), the
    walk-away dim, a closed lid or "off" hold it. screen_off is a callable."""
    if not enabled:
        return "off"
    if lid_closed:
        return "lid closed"
    if walk_away:
        return "walk-away dim"
    if screen_off():
        return "screen off"
    if not have_reading:
        return "no reading"
    return "auto"


def kbd_saved(kbd):
    """Omarchy's lock blank record: `omarchy-brightness-keyboard off` saves the
    level here before blanking the keys, `restore` puts it back and deletes it."""
    return os.path.join(RUN, f"omarchy-brightness-keyboard-{kbd.name}")


def blank_saved(kbd, max_age):
    """A fresh lock blank record exists (the lock screen has the keys blanked,
    or its restore is still to come). Older than max_age: stale, ignored."""
    try:
        st = os.stat(kbd_saved(kbd))
    except OSError:
        return False
    return st.st_size > 0 and time.time() - st.st_mtime < max_age


def kbd_write(kbd, level, max_age):
    """2.16.0: write the keyboard level under the lock Omarchy's off/restore
    take, and never behind a fresh blank record. False = try again later."""
    fd = None
    try:
        fd = os.open(kbd_saved(kbd) + ".lock", os.O_WRONLY | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        if fd is not None:  # off/restore is running right now
            os.close(fd)
            return False
        fd = None           # no runtime dir to lock in: write anyway
    try:
        if blank_saved(kbd, max_age):
            return False
        kbd.set(level)
        return True
    finally:
        if fd is not None:
            os.close(fd)


def _systemctl(*args, timeout=5):
    try:
        return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


def replace_upstream(keyboard):
    """2.16.0: stop other auto-brightness services for this session (they
    would fight over the same backlight) and say so. Returns log lines."""
    units = list(REPLACES_SCREEN) + (list(REPLACES_KBD) if keyboard else [])
    out = []
    r = _systemctl("is-active", *units)
    states = r.stdout.split() if r is not None else []
    for u, state in zip(units, states):
        if state not in ("active", "activating", "reloading"):
            continue
        _systemctl("stop", u, timeout=15)
        try:
            with open(REPLACED, "a") as f:
                f.write(u + "\n")
        except OSError:
            pass
        out.append(f"stopped {u} for this session (Auto Brightness replaces it)")
    if keyboard and shutil.which("omarchy-toggle-keyboard-backlight-auto") and not os.path.exists(KBD_TOGGLE):
        try:
            os.makedirs(os.path.dirname(KBD_TOGGLE), exist_ok=True)
            os.makedirs(os.path.dirname(KBD_TOGGLE_MINE), exist_ok=True)
            open(KBD_TOGGLE, "a").close()
            open(KBD_TOGGLE_MINE, "a").close()
            subprocess.run(["omarchy-shell", "-q", "omarchy.keyboard-backlight", "sync"],
                           capture_output=True, timeout=5)
            out.append("turned off Omarchy's automatic keyboard backlight (Auto Brightness replaces it)")
        except Exception:
            pass
    return out


def restore_replaced(keyboard=True):
    """Undo replace_upstream: start what it stopped (if still enabled) and
    remove the keyboard flag it set. Used by uninstall.sh."""
    out = []
    try:
        with open(REPLACED) as f:
            units = list(dict.fromkeys(l.strip() for l in f if l.strip()))
    except OSError:
        units = []
    left = []
    for u in units:
        if not keyboard and u not in REPLACES_KBD:
            left.append(u)
            continue
        r = _systemctl("is-enabled", u)
        if r is not None and r.stdout.strip() in ("enabled", "enabled-runtime"):
            _systemctl("start", u, timeout=15)
            out.append(f"started {u} again")
    try:
        if left:
            with open(REPLACED, "w") as f:
                f.write("".join(u + "\n" for u in left))
        else:
            os.remove(REPLACED)
    except OSError:
        pass
    if keyboard and os.path.exists(KBD_TOGGLE_MINE):
        for f in (KBD_TOGGLE, KBD_TOGGLE_MINE):
            try:
                os.remove(f)
            except OSError:
                pass
        try:
            subprocess.run(["omarchy-shell", "-q", "omarchy.keyboard-backlight", "sync"], capture_output=True, timeout=5)
        except Exception:
            pass
        out.append("turned Omarchy's automatic keyboard backlight back on")
    return out


def run():
    sens = sensor()
    bl_path = find_dev("backlight", "*")
    if not sens or not bl_path:
        log("no ambient light sensor or backlight found; exiting")
        return 1
    bl = Dev(bl_path)
    kp = find_dev("leds", "*kbd_backlight")
    kbd = Dev(kp) if kp else None
    log(f"sensor={sens[0]} backlight={bl.name} kbd={kbd.name if kbd else None}")
    c = load_conf()
    ctl = Controller(c)
    filt = SensorFilter(c["sensorMedianSeconds"], c)
    dlog = DecisionLog(DLOG, c["logMaxBytes"])
    trigger = "start"
    dlog.write(event="start", version=VERSION, sensor=os.path.basename(os.path.dirname(sens[0])))
    def _stop_signal(signum, frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, _stop_signal)
    held = False
    conf_mtime = None
    last_set = None          # raw we last wrote
    was_closed = False
    last_wall, last_mono = time.time(), time.monotonic()
    reason = ""
    # 2.16.0: the sensor is read in the background at most every
    # sampleSeconds; the loop itself still runs at 60 Hz while fading, for
    # smooth brightness writes
    reader = SensorReader(sens)
    sample, filtered = None, None
    # 2.16.0: after a blank, resume or lid open the keyboard waits for
    # Omarchy's restore: (since, the level auto had chosen before)
    kbd_pending = None
    saw_blank = False        # a lock blank record existed during this screen-off hold
    last_replace = None
    prev_reason = ""
    try:
        while True:
            t = time.monotonic()
            if last_replace is None or t - last_replace >= 60:
                last_replace = t
                for msg in replace_upstream(c["keyboard"] and kbd is not None):
                    if c["debugLog"]:
                        log(msg)
                        dlog.write(event=msg, trigger="replace")
            m = os.path.getmtime(CONF) if os.path.exists(CONF) else None
            if m != conf_mtime:
                old, (c, conf_mtime) = c, (load_conf(), m)
                if (old["min"], old["max"]) != (c["min"], c["max"]):
                    ctl.preview_until = t + c["previewSeconds"]  # 2.12.0: slider drag, show it live
                ctl.c = c
                filt.c = c
            # resume detection: wall clock jumped further than the monotonic one
            wall = time.time()
            if (wall - last_wall) - (t - last_mono) > 20:
                kbd_pending = (t, ctl.kbd_want if kbd_pending is None else kbd_pending[1])
                ctl.reset(t, "resume")
                trigger = "resume"
                filt.clear()
                last_set = None
                reader.flush(t)
            last_wall, last_mono = wall, t
            closed = lid_closed()
            if was_closed and not closed:
                kbd_pending = (t, ctl.kbd_want if kbd_pending is None else kbd_pending[1])
                ctl.reset(t, "lid opened")
                trigger = "lid opened"
                filt.clear()
                last_set = None
                reader.flush(t)
            was_closed = closed
            ctl.new_day(t, datetime.date.today().isoformat())
            reader.interval = c["popupSampleSeconds"] if popup_open() else c["sampleSeconds"]
            reader.min_gap = c["sampleMinGapSeconds"]
            got = reader.take(t)
            if got is not None:
                ts, sample, _ = got
                filtered = filt.feed(ts, sample)
                ctl.feed_lux(ts, filtered)
            msgs = [msg for _, msg in ctl.events]
            if filt.note:
                if c["debugLog"] or default_log_event(filt.note):
                    log(filt.note)
                msgs.insert(0, filt.note)
                filt.note = ""  # 2.16.0: not every pass feeds the filter any more
            for msg in [m for _, m in ctl.events]:
                if c["debugLog"] or default_log_event(msg):
                    log(msg)
            ctl.events.clear()

            if prev_reason == "screen off" and kbd is not None:
                # 2.16.0: Omarchy's wake runs `dpms on` and then the keyboard
                # restore, which deletes the blank record: once it is gone the
                # screen is on, so look again now instead of after the 2 s cache
                if os.path.exists(kbd_saved(kbd)):
                    saw_blank = True
                elif saw_blank:
                    _cache.pop("dpms", None)
            reason = hold_reason(c["enabled"], closed, os.path.exists(HOLD_FLAG), screen_off, ctl.stable is not None)
            video_hold = False
            low_bat = False

            cur = bl.get()
            busy = False
            if reason == "auto" and held:
                # 2.16.0: coming back from a hold. The keyboard waits for Omarchy's
                # restore and then keeps the level unless the room crossed a
                # keyboard line meanwhile (was: always re-applied, which undid a
                # key press to off and could race the restore).
                if kbd_pending is None:
                    kbd_pending = (t, ctl.kbd_want)
                if prev_reason in ("screen off", "walk-away dim"):
                    # like a MacBook display waking: match the room right away
                    ctl.screen_wake_until = t + c["wakeSeconds"]
                    trigger = "screen on"
            if reason != "screen off":
                saw_blank = False
            prev_reason = reason
            held = reason != "auto"
            if reason == "auto":
                # 2.16.0: any change of 2 raw steps / 0.5 % is yours (was 1.5 %,
                # which faded Omarchy's 1 % steps back); we compare against the
                # exact raw value we wrote, so our own writes never count
                if last_set is not None and abs(cur - last_set) >= max(2, bl.max * 0.005):
                    ctl.manual(t, cur / bl.max * 100, datetime.date.today().isoformat())
                no_dim = fullscreen_video()
                tg = ctl.target()
                video_hold = bool(no_dim and tg is not None and tg < cur / bl.max * 100 - 1)
                pct = ctl.step(t, cur / bl.max * 100, no_dim=no_dim)
                if pct is not None:
                    raw = max(1, round(pct / 100 * bl.max))
                    if raw != cur:
                        bl.set(raw)
                    cur = raw
                busy = ctl.ramp is not None
                last_set = cur
                if kbd and c["keyboard"] and kbd_pending is not None:
                    since, before = kbd_pending
                    waited = t - since
                    # the record is as old as the blank (hours, maybe): any record
                    # means the restore is still to come
                    restoring = blank_saved(kbd, float("inf"))
                    if (ctl.stable is not None and waited >= c["kbdRestoreSeconds"]
                            and (not restoring or waited >= c["kbdRestoreMaxSeconds"])):
                        kbd_pending = None
                        ctl.kbd_want, ctl.kbd_dark = before, None
                        band = ctl.kbd_band(kbd.max, before)
                        if before is not None and (band is None or band == before):
                            msgs.append(f"keyboard left as it is after {trigger} (room still level {before})")
                if kbd and c["keyboard"] and kbd_pending is None:
                    # 2.15.0: low battery caps what auto sets at level 1; 2.16.0:
                    # only matters when kbdMaxLevel is above 1. A key press to a
                    # higher level still sticks (only transitions are written).
                    top = min(kbd.max, int(c["kbdMaxLevel"]))
                    low_bat = top > 1 and low_battery(c)
                    want = ctl.kbd_level(1 if low_bat else kbd.max, t)
                    # only act on transitions, so the firmware idle-off and the
                    # user's own key presses are never overridden
                    if want is not None and want != ctl.kbd_want:
                        why = " (low battery cap)" if low_bat else ""
                        if kbd_write(kbd, want, c["kbdRestoreMaxSeconds"]):
                            if c["debugLog"]:
                                log(f"lux={ctl.stable:.1f} keyboard -> {want}{why}")
                            msgs.append(f"keyboard -> {want}{why}")
                            ctl.kbd_want = want
                for et, msg in ctl.events:
                    if c["debugLog"] or default_log_event(msg):
                        log(msg)
                    msgs.append(msg)
                ctl.events.clear()
            else:
                last_set = None
                ctl.ramp = None
            if reason != dlog.last_reason:
                msgs.append(f"mode {dlog.last_reason} -> {reason}")
                dlog.last_reason = reason
            debug = c["debugLog"]
            kept = [m for m in msgs if debug or default_log_event(m)]
            if kept or (debug and t - dlog.last_beat >= 60):
                event = "; ".join(kept) if kept else "heartbeat"
                if debug:
                    tg = ctl.target()
                    dlog.write(event=event, trigger=trigger,
                               raw=None if sample is None else round(sample, 1),
                               median=None if filt.median is None else round(filt.median, 1),
                               readMs=reader.ms,
                               filtered=None if filtered is None else round(filtered, 1),
                               stable=None if ctl.stable is None else round(ctl.stable, 1),
                               target=None if tg is None else round(tg, 1),
                               current=round(bl.get() / bl.max * 100, 1),
                               mode=reason, wake=ctl.waking(t), offset=round(ctl.offset, 1),
                               kbd=ctl.kbd_want, fade=None if ctl.ramp is None else [round(ctl.ramp[1]), round(ctl.ramp[2]), ctl.ramp[3]],
                               memKB=mem_kb())
                    dlog.last_beat = t
                else:
                    dlog.write(event=event, trigger=trigger, mode=reason)
                trigger = "sensor"

            write_state({
                "ts": round(time.time(), 1),
                "enabled": c["enabled"], "min": c["min"], "max": c["max"], "keyboard": c["keyboard"],
                "lux": None if ctl.stable is None else round(ctl.stable, 1),
                "screen": round(bl.get() / bl.max * 100),
                "target": None if ctl.target() is None else round(ctl.target()),
                "offset": round(ctl.offset), "mode": reason,
                # 2.12.0: for the popup's status line and live lux
                "luxNow": None if filt.live is None else round(filt.live, 1),
                "fadeTo": None if ctl.ramp is None else round(ctl.ramp[2]),
                "videoHold": video_hold, "waking": ctl.waking(t),
                "dark": ctl.stable is not None and ctl.stable < c["kbdOnBelow"],
                "lowBattery": low_bat,  # 2.15.0: the keyboard cap at level 1 is active
                **({"kbdLevel": kbd.get(), "kbdMax": kbd.max} if kbd else {}),
            })
            # 2.9.0: 60 Hz while fading. 2.16.5: idle at 0.25 s so sliders and
            # keys stay live; the sensor itself is still read at most 1 Hz.
            time.sleep(1 / 60 if busy else 0.25)
    finally:
        dlog.write(event="stop", version=VERSION)


def describe_sensors():
    """The sensor the daemon reads: which device, what it exposes."""
    sens = sensor()
    if sens is None:
        return []
    d = os.path.dirname(sens[0])
    ch = sorted({os.path.basename(p).split("_")[1] for p in glob.glob(d + "/in_*_raw") + glob.glob(d + "/in_*_input")})
    return [{"device": os.path.basename(d), "channels": ch}]


def kbd_dev():
    p = find_dev("leds", "*kbd_backlight")
    return Dev(p) if p else None


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "run":
        return run() or 0
    if cmd == "lux":
        print(lux_now(sensor()))
        return 0
    if cmd == "sensors":
        print(json.dumps(describe_sensors(), indent=1))
        return 0
    if cmd == "restore-replaced":
        for msg in restore_replaced():
            print(msg)
        return 0
    c = load_conf()
    if cmd in ("on", "off", "toggle"):
        c["enabled"] = (cmd == "on") or (cmd == "toggle" and not c["enabled"])
        save_conf(c)
    elif cmd == "set" and len(argv) == 4:
        k, v = argv[2], argv[3]
        if k in ("min", "max"):
            c[k] = int(float(v))
        elif k in ("keyboard", "kbd"):
            c["keyboard"] = v in ("on", "1", "true")
        elif k in ("kbd-max", "kbdMaxLevel"):
            c["kbdMaxLevel"] = max(0, int(float(v)))  # 2.16.0: highest level auto sets
        else:
            print(__doc__, file=sys.stderr)
            return 2
        save_conf(c, ("kbdMaxLevel",) if k in ("kbd-max", "kbdMaxLevel") else ())
        c = load_conf()
    elif cmd == "debug-log":
        # 2.16.6: opt-in detailed decision log
        if len(argv) == 2:
            print("on" if c["debugLog"] else "off")
            return 0
        if len(argv) == 3 and argv[2] in ("on", "off"):
            c["debugLog"] = argv[2] == "on"
            save_conf(c, ("debugLog",))
            print("debug-log " + argv[2])
            return 0
        print(__doc__, file=sys.stderr)
        return 2
    elif cmd == "kbd-level" and len(argv) == 3:
        # Written like a key press: the daemon is not told, so it changes the
        # light again only when the room moves into another keyboard range or
        # after the screen wakes.
        kbd = kbd_dev()
        if kbd is None:
            print("no keyboard backlight", file=sys.stderr)
            return 1
        try:
            level = int(argv[2])
        except ValueError:
            print(__doc__, file=sys.stderr)
            return 2
        kbd.set(max(0, min(kbd.max, level)))
    elif cmd != "status":
        print(__doc__, file=sys.stderr)
        return 2
    try:
        with open(STATE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {"mode": "not running"}
    if time.time() - st.get("ts", time.time()) > STALE_SECONDS:
        st["mode"] = "not running"
    st.update({"enabled": c["enabled"], "min": c["min"], "max": c["max"], "keyboard": c["keyboard"]})
    kbd = kbd_dev()
    if kbd is not None:
        st.update({"kbdLevel": kbd.get(), "kbdMax": kbd.max})
    print(json.dumps(st))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
